<!-- Header -->
<%- include('partials/header') %>

<!-- Main Content -->
<div class="grow flex flex-col lg:flex-row lg:max-w-[1400px] lg:mx-auto lg:w-full lg:p-6 lg:gap-6 overflow-hidden">

    <main class="flex-1 relative bg-gray-200 lg:rounded-3xl lg:shadow-xl overflow-hidden flex flex-col z-0">
        
        <div id="map" class="w-full h-full z-0"></div>
        
        <div id="map-overlay" class="absolute inset-0 bg-brand-dark/40 backdrop-blur-3px z-20 transition-opacity duration-500"></div>

        <div id="panel-info" class="hidden absolute top-6 left-1/2 -translate-x-1/2 lg:left-6 lg:translate-x-0 z-30 w-auto min-w-[240px] max-w-[90%] bg-white/30 backdrop-blur-md px-4 py-2 rounded-2xl shadow-md border border-white/50 flex flex-row justify-evenly items-center transition-all duration-300">
            <div class="flex flex-col items-center w-1/2">
                <span class="text-gray-600 text-[8px] uppercase tracking-wider font-extrabold mb-0.5">Distancia</span>
                <span id="info-distancia" class="text-brand-primary font-black text-lg leading-none">-- m</span>
            </div>
            <div class="h-9 w-px bg-gray-600 mx-4"></div>
            <div class="flex flex-col items-center w-1/2">
                <span class="text-gray-600 text-[9px] uppercase tracking-wider font-extrabold mb-0.5">Tiempo</span>
                <span id="info-tiempo" class="text-brand-accent font-black text-lg leading-none">-- min</span>
            </div>
        </div>

        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-30 w-11/12 max-w-sm">
            <button id="btn-aparcar" class="w-full bg-brand-primary text-white py-4 rounded-2xl shadow-xl shadow-brand-primary/20 font-bold text-lg flex items-center justify-center gap-2 hover:bg-brand-secondary transition-colors disabled:opacity-70 disabled:cursor-not-allowed">
                Aparcar Aquí
            </button>
        </div>

    </main>

	<aside class="hidden lg:flex flex-col w-96 bg-white lg:rounded-3xl lg:shadow-xl z-[10] overflow-hidden shrink-0 border border-slate-200">        
		
        <div class="p-6 border-b border-slate-200 bg-white shrink-0 flex items-center justify-between z-10">
            <h2 class="font-bold text-brand-primary text-xl tracking-tight">Mis Aparcamientos</h2>
        </div>
        
        <div id="lista-historial-desktop" class="p-4 overflow-y-auto grow flex flex-col gap-4 bg-gray-50/30">
            <div class="flex flex-col items-center justify-center h-full text-gray-400">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-12 mb-2 opacity-50">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                <p class="text-sm">Cargando historial...</p>
            </div>
        </div>

    </aside>

</div>

<!-- Footer -->
<%- include('partials/footer') %>

<!-- Menu lateral offcanvas -->
<%- include('partials/offcanvas') %>

<!-- Modal Login/Registro -->
<%- include('partials/modal-login') %>

<!-- Modal Historial de Aparcamientos -->
<%- include('partials/modal-historial') %>